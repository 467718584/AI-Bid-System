# =============================================
# AI Bid System - Environment Configuration
# =============================================

# Spring Profile
SPRING_PROFILES=docker

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aidbid
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=ai-bid-system-jwt-secret-key-2024
JWT_EXPIRE_TIME=604800000

# Service Ports
GATEWAY_PORT=8080
USER_PORT=8081
PROJECT_PORT=8082
MATERIAL_PORT=8083
DOCUMENT_PORT=8084

# File Upload
UPLOAD_PATH=/data/uploads
MAX_FILE_SIZE=10485760

# AI Configuration
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4
AI_EMBEDDING_MODEL=text-embedding-ada-002
