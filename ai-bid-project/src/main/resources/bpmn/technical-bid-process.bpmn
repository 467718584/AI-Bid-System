<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_TechnicalBid"
                   targetNamespace="http://bpmn.io/schema/bpmn">

    <!-- =============================================
         技术标流程 (Technical Bid Process)
         流程：招标文件上传 → 自动解析 → 技术标生成 → 人工审核 → 导出标书
         ============================================= -->

    <bpmn:process id="technicalBidProcess" name="技术标流程" isExecutable="true">

        <!-- 流程变量 -->
        <bpmn:extensionElements>
            <camunda:inputOutput>
                <camunda:inputParameter name="projectId"/>
                <camunda:inputParameter name="enterpriseId"/>
                <camunda:inputParameter name="documentId"/>
                <camunda:inputParameter name="bidDocument"/>
                <camunda:inputParameter name="reviewComment"/>
            </camunda:inputOutput>
        </bpmn:extensionElements>

        <!-- ==================== 开始事件 ==================== -->
        <bpmn:startEvent id="StartEvent" name="开始">
            <bpmn:outgoing>Flow_Upload</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- ==================== 用户任务：招标文件上传 ==================== -->
        <bpmn:userTask id="Task_Upload" name="招标文件上传">
            <bpmn:incoming>Flow_Upload</bpmn:incoming>
            <bpmn:outgoing>Flow_Parse</bpmn:outgoing>
            <bpmn:extensionElements>
                <camunda:formData>
                    <camunda:formField id="documentFile" label="招标文件" type="File"/>
                </camunda:formData>
                <camunda:assignee>${initiator}</camunda:assignee>
            </bpmn:extensionElements>
        </bpmn:userTask>

        <!-- ==================== 服务任务：自动解析招标文件 ==================== -->
        <bpmn:serviceTask id="Task_Parse" name="自动解析招标文件">
            <bpmn:incoming>Flow_Parse</bpmn:incoming>
            <bpmn:outgoing>Flow_Generate</bpmn:outgoing>
            <bpmn:extensionElements>
                <camunda:inputOutput>
                    <camunda:inputParameter name="documentId">${documentId}</camunda:inputParameter>
                </camunda:inputOutput>
                <camunda:executionListener event="start" class="com.aibid.project.listener.ParseDocumentListener"/>
                <camunda:executionListener event="end" class="com.aibid.project.listener.ParseDocumentCompleteListener"/>
            </bpmn:extensionElements>
        </bpmn:serviceTask>

        <!-- ==================== 服务任务：生成技术标 ==================== -->
        <bpmn:serviceTask id="Task_Generate" name="生成技术标">
            <bpmn:incoming>Flow_Generate</bpmn:incoming>
            <bpmn:outgoing>Flow_Review</bpmn:outgoing>
            <bpmn:extensionElements>
                <camunda:inputOutput>
                    <camunda:inputParameter name="projectId">${projectId}</camunda:inputParameter>
                    <camunda:inputParameter name="enterpriseId">${enterpriseId}</camunda:inputParameter>
                </camunda:inputOutput>
                <camunda:executionListener event="start" class="com.aibid.project.listener.GenerateTechnicalBidListener"/>
            </bpmn:extensionElements>
        </bpmn:serviceTask>

        <!-- ==================== 用户任务：人工审核 ==================== -->
        <bpmn:userTask id="Task_Review" name="人工审核">
            <bpmn:incoming>Flow_Review</bpmn:incoming>
            <bpmn:outgoing>Flow_ApproveOrReject</bpmn:outgoing>
            <bpmn:extensionElements>
                <camunda:formData>
                    <camunda:formField id="reviewResult" label="审核结果" type="enum">
                        <camunda:value value="APPROVED" name="通过"/>
                        <camunda:value value="REJECTED" name="驳回"/>
                    </camunda:formField>
                    <camunda:formField id="reviewComment" label="审核意见" type="string"/>
                </camunda:formData>
            </bpmn:extensionElements>
        </bpmn:userTask>

        <!-- ==================== 排他网关：审核结果判断 ==================== -->
        <bpmn:exclusiveGateway id="Gateway_ApproveOrReject" name="审核结果判断">
            <bpmn:incoming>Flow_ApproveOrReject</bpmn:incoming>
            <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
            <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <!-- ==================== 用户任务：修改技术标 (驳回后) ==================== -->
        <bpmn:userTask id="Task_Modify" name="修改技术标">
            <bpmn:incoming>Flow_Rejected</bpmn:incoming>
            <bpmn:outgoing>Flow_ReviseGenerate</bpmn:outgoing>
        </bpmn:userTask>

        <!-- ==================== 服务任务：重新生成技术标 ==================== -->
        <bpmn:serviceTask id="Task_ReviseGenerate" name="重新生成技术标">
            <bpmn:incoming>Flow_ReviseGenerate</bpmn:incoming>
            <bpmn:outgoing>Flow_Review</bpmn:outgoing>
            <bpmn:extensionElements>
                <camunda:executionListener event="start" class="com.aibid.project.listener.ReviseTechnicalBidListener"/>
            </bpmn:extensionElements>
        </bpmn:serviceTask>

        <!-- ==================== 服务任务：导出标书 ==================== -->
        <bpmn:serviceTask id="Task_Export" name="导出标书">
            <bpmn:incoming>Flow_Approved</bpmn:incoming>
            <bpmn:outgoing>Flow_End</bpmn:outgoing>
            <bpmn:extensionElements>
                <camunda:inputOutput>
                    <camunda:inputParameter name="projectId">${projectId}</camunda:inputParameter>
                    <camunda:inputParameter name="format">docx</camunda:inputParameter>
                </camunda:inputOutput>
                <camunda:executionListener event="start" class="com.aibid.project.listener.ExportBidDocumentListener"/>
            </bpmn:extensionElements>
        </bpmn:serviceTask>

        <!-- ==================== 结束事件 ==================== -->
        <bpmn:endEvent id="EndEvent" name="结束">
            <bpmn:incoming>Flow_End</bpmn:incoming>
        </bpmn:endEvent>

        <!-- ==================== 流程连线 ==================== -->
        <bpmn:sequenceFlow id="Flow_Upload" sourceRef="StartEvent" targetRef="Task_Upload"/>
        <bpmn:sequenceFlow id="Flow_Parse" sourceRef="Task_Upload" targetRef="Task_Parse"/>
        <bpmn:sequenceFlow id="Flow_Generate" sourceRef="Task_Parse" targetRef="Task_Generate"/>
        <bpmn:sequenceFlow id="Flow_Review" sourceRef="Task_Generate" targetRef="Task_Review"/>
        <bpmn:sequenceFlow id="Flow_ApproveOrReject" sourceRef="Task_Review" targetRef="Gateway_ApproveOrReject"/>

        <!-- 审核通过 -->
        <bpmn:sequenceFlow id="Flow_Approved" name="通过" sourceRef="Gateway_ApproveOrReject" targetRef="Task_Export">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                reviewResult == 'APPROVED'
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <!-- 审核驳回 -->
        <bpmn:sequenceFlow id="Flow_Rejected" name="驳回" sourceRef="Gateway_ApproveOrReject" targetRef="Task_Modify">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                reviewResult == 'REJECTED'
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="Flow_ReviseGenerate" sourceRef="Task_Modify" targetRef="Task_ReviseGenerate"/>
        <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Export" targetRef="EndEvent"/>

    </bpmn:process>

    <!-- ==================== 图形信息 ==================== -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_TechnicalBid">
        <bpmndi:BPMNPlane id="BPMNPlane_TechnicalBid" bpmnElement="technicalBidProcess">

            <!-- 开始事件 -->
            <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent" isHorizontal="true">
                <dc:Bounds x="100" y="200" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="102" y="244" width="32" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 招标文件上传 -->
            <bpmndi:BPMNShape id="Task_Upload_di" bpmnElement="Task_Upload" isHorizontal="true">
                <dc:Bounds x="200" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="206" y="204" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 自动解析 -->
            <bpmndi:BPMNShape id="Task_Parse_di" bpmnElement="Task_Parse" isHorizontal="true">
                <dc:Bounds x="360" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="366" y="204" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 生成技术标 -->
            <bpmndi:BPMNShape id="Task_Generate_di" bpmnElement="Task_Generate" isHorizontal="true">
                <dc:Bounds x="520" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="526" y="204" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 人工审核 -->
            <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review" isHorizontal="true">
                <dc:Bounds x="680" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="686" y="204" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 网关 -->
            <bpmndi:BPMNShape id="Gateway_ApproveOrReject_di" bpmnElement="Gateway_ApproveOrReject" isHorizontal="true">
                <dc:Bounds x="840" y="185" width="50" height="50"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="836" y="243" width="58" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 修改技术标 -->
            <bpmndi:BPMNShape id="Task_Modify_di" bpmnElement="Task_Modify" isHorizontal="true">
                <dc:Bounds x="680" y="300" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="686" y="344" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 重新生成 -->
            <bpmndi:BPMNShape id="Task_ReviseGenerate_di" bpmnElement="Task_ReviseGenerate" isHorizontal="true">
                <dc:Bounds x="520" y="300" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="526" y="344" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 导出标书 -->
            <bpmndi:BPMNShape id="Task_Export_di" bpmnElement="Task_Export" isHorizontal="true">
                <dc:Bounds x="950" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="956" y="204" width="88" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 结束事件 -->
            <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent" isHorizontal="true">
                <dc:Bounds x="1100" y="185" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="1102" y="229" width="32" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</bpmn:definitions>